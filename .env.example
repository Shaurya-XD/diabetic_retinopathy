# Server-only secrets. Never prefix these with VITE_.
MONGODB_URI=
JWT_SECRET=
DEMO_MODE=false

# Server-only Railway endpoint (local development uses the separately started FastAPI service).
ML_SERVICE_URL=http://localhost:8000
CLIENT_ORIGIN=http://localhost:5173

# Production persistent object storage (create a Vercel Blob store first).
BLOB_READ_WRITE_TOKEN=
STORAGE_MODE=vercel-blob
INTERNAL_ML_SECRET=
